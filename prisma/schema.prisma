generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  HR
  FINANCE
  EMPLOYEE
}

model User {
  id               String       @id @default(uuid()) @db.Uuid
  email            String       @unique
  passwordHash     String
  active           Boolean      @default(true)
  tokenVersion     Int          @default(0)
  failedLoginCount Int          @default(0)
  lockedUntil      DateTime?    @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  memberships      Membership[]

  @@map("users")
}

model Company {
  id                          String                       @id @default(uuid()) @db.Uuid
  name                        String
  timezone                    String                       @default("Asia/Kuala_Lumpur")
  currency                    String                       @default("MYR") @db.Char(3)
  active                      Boolean                      @default(true)
  memberships                 Membership[]
  employees                   Employee[]
  registrationNo              String?
  email                       String?
  contactNo                   String?
  financialYearStartMonth     Int                          @default(1)
  departments                 Department[]
  positions                   Position[]
  locations                   WorkLocation[]
  schedules                   WorkSchedule[]
  holidays                    PublicHoliday[]
  leavePolicies               LeavePolicy[]
  claimTypes                  ClaimType[]
  auditEvents                 AuditEvent[]
  statutoryRules              StatutoryRuleset[]
  payrollSettings             PayrollSettings?
  payrollRuns                 PayrollRun[]
  payrollComponentDefinitions PayrollComponentDefinition[]

  @@map("companies")
}

model Membership {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  companyId  String    @db.Uuid
  employeeId String?   @db.Uuid
  employee   Employee? @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)
  roles      Role[]
  active     Boolean   @default(true)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, userId])
  @@unique([companyId, employeeId])
  @@map("company_memberships")
}

model Employee {
  id                     String                          @id @default(uuid()) @db.Uuid
  companyId              String                          @db.Uuid
  employeeNo             String
  name                   String
  email                  String?
  joinedDate             DateTime                        @db.Date
  active                 Boolean                         @default(true)
  departmentId           String?                         @db.Uuid
  positionId             String?                         @db.Uuid
  department             Department?                     @relation(fields: [companyId, departmentId], references: [companyId, id], onDelete: Restrict)
  position               Position?                       @relation(fields: [companyId, positionId], references: [companyId, id], onDelete: Restrict)
  createdAt              DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                        @updatedAt @db.Timestamptz(3)
  company                Company                         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  salaries               SalaryHistory[]
  membership             Membership?
  managerId              String?                         @db.Uuid
  manager                Employee?                       @relation("Manager", fields: [companyId, managerId], references: [companyId, id], onDelete: Restrict)
  reports                Employee[]                      @relation("Manager")
  locationId             String?                         @db.Uuid
  scheduleId             String?                         @db.Uuid
  location               WorkLocation?                   @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)
  schedule               WorkSchedule?                   @relation(fields: [companyId, scheduleId], references: [companyId, id], onDelete: Restrict)
  attendance             AttendanceSession[]
  leaveRequests          LeaveRequest[]
  leaveLedger            LeaveLedger[]
  claims                 Claim[]
  files                  StoredFile[]
  payrollProfile         EmployeePayrollProfile?
  payrollProfileVersions EmployeePayrollProfileVersion[]
  payslips               PayrollEmployee[]
  payrollInputs          PayrollInput[]
  taxOpenings            EmployeeTaxOpening[]
  taxFamilyVersions      EmployeeTaxFamily[]
  taxExpenseVersions     EmployeeTaxExpenses[]

  @@unique([companyId, id])
  @@unique([companyId, employeeNo])
  @@map("employees")
}

model Department {
  id          String     @id @default(uuid()) @db.Uuid
  companyId   String     @db.Uuid
  code        String
  name        String
  description String?
  active      Boolean    @default(true)
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees   Employee[]
  positions   Position[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@map("departments")
}

model Position {
  id           String     @id @default(uuid()) @db.Uuid
  companyId    String     @db.Uuid
  departmentId String     @db.Uuid
  code         String
  title        String
  active       Boolean    @default(true)
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department   Department @relation(fields: [companyId, departmentId], references: [companyId, id], onDelete: Restrict)
  employees    Employee[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@map("positions")
}

model SalaryHistory {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  employeeId    String    @db.Uuid
  amount        Decimal   @db.Decimal(14, 2)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  employee      Employee  @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, employeeId, effectiveFrom])
  @@map("salary_history")
}

model WorkLocation {
  id        String     @id @default(uuid()) @db.Uuid
  companyId String     @db.Uuid
  code      String
  name      String
  state     String
  address   String?
  timezone  String     @default("Asia/Kuala_Lumpur")
  active    Boolean    @default(true)
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees Employee[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@map("work_locations")
}

model WorkSchedule {
  id            String     @id @default(uuid()) @db.Uuid
  companyId     String     @db.Uuid
  code          String
  name          String
  workingDays   Int[]
  startMinute   Int
  endMinute     Int
  breakMinutes  Int        @default(0)
  graceMinutes  Int        @default(0)
  effectiveFrom DateTime   @db.Date
  effectiveTo   DateTime?  @db.Date
  active        Boolean    @default(true)
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees     Employee[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@map("work_schedules")
}

model PublicHoliday {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  states    String[]
  active    Boolean  @default(true)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, startDate, endDate])
  @@map("public_holidays")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  actorId    String   @db.Uuid
  action     String
  resourceId String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@map("audit_events")
}

model AttendanceSession {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  employeeId  String    @db.Uuid
  clockIn     DateTime  @db.Timestamptz(3)
  clockOut    DateTime? @db.Timestamptz(3)
  clockInKey  String
  clockOutKey String?
  employee    Employee  @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, employeeId, clockInKey])
  @@unique([companyId, employeeId, clockOutKey])
  @@index([companyId, employeeId, clockIn])
  @@map("attendance_sessions")
}

enum RequestStatus {
  DRAFT
  PENDING_MANAGER
  PENDING_HR
  PENDING_FINANCE
  APPROVED
  REJECTED
  CANCELLED
  PAID
}

enum LeaveApproval {
  MANAGER
  MANAGER_HR
  HR_ONLY
  NO_APPROVAL
}

model LeavePolicy {
  id            String         @id @default(uuid()) @db.Uuid
  companyId     String         @db.Uuid
  code          String
  name          String
  paid          Boolean        @default(true)
  active        Boolean        @default(true)
  annualDays    Decimal        @db.Decimal(7, 2)
  allowHalfDay  Boolean        @default(false)
  noticeDays    Int            @default(0)
  approval      LeaveApproval  @default(HR_ONLY)
  effectiveFrom DateTime       @db.Date
  effectiveTo   DateTime?      @db.Date
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requests      LeaveRequest[]
  ledger        LeaveLedger[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@map("leave_policies")
}

model LeaveRequest {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @db.Uuid
  employeeId      String        @db.Uuid
  policyId        String        @db.Uuid
  startDate       DateTime      @db.Date
  endDate         DateTime      @db.Date
  halfDay         Boolean       @default(false)
  days            Decimal       @db.Decimal(7, 2)
  daySnapshot     Json?
  reason          String
  status          RequestStatus @default(DRAFT)
  managerId       String?       @db.Uuid
  approval        LeaveApproval
  paid            Boolean
  decisionComment String?
  decidedBy       String?       @db.Uuid
  decidedAt       DateTime?     @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  employee        Employee      @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)
  policy          LeavePolicy   @relation(fields: [companyId, policyId], references: [companyId, id], onDelete: Restrict)
  ledger          LeaveLedger[]
  events          LeaveEvent[]

  @@unique([companyId, id])
  @@index([companyId, employeeId, startDate, endDate])
  @@map("leave_requests")
}

model LeaveEvent {
  id        String        @id @default(uuid()) @db.Uuid
  companyId String        @db.Uuid
  requestId String        @db.Uuid
  actorId   String        @db.Uuid
  action    String
  status    RequestStatus
  comment   String?
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  request   LeaveRequest  @relation(fields: [companyId, requestId], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, requestId, createdAt])
  @@map("leave_events")
}

model LeaveLedger {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String        @db.Uuid
  employeeId     String        @db.Uuid
  policyId       String        @db.Uuid
  requestId      String?       @db.Uuid
  year           Int
  days           Decimal       @db.Decimal(7, 2)
  kind           String
  reason         String
  idempotencyKey String
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  employee       Employee      @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)
  policy         LeavePolicy   @relation(fields: [companyId, policyId], references: [companyId, id], onDelete: Restrict)
  request        LeaveRequest? @relation(fields: [companyId, requestId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, idempotencyKey])
  @@index([companyId, employeeId, policyId, year])
  @@map("leave_ledger")
}

model ClaimType {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  code            String
  name            String
  active          Boolean   @default(true)
  description     String?
  receiptRequired Boolean   @default(false)
  maxAmount       Decimal?  @db.Decimal(14, 2)
  effectiveFrom   DateTime? @db.Date
  effectiveTo     DateTime? @db.Date
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  claims          Claim[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@map("claim_types")
}

model Claim {
  payrollRunId         String?       @db.Uuid
  payrollComponentCode String?
  payrollRun           PayrollRun?   @relation(fields: [companyId, payrollRunId], references: [companyId, id], onDelete: Restrict)
  id                   String        @id @default(uuid()) @db.Uuid
  companyId            String        @db.Uuid
  employeeId           String        @db.Uuid
  typeId               String        @db.Uuid
  date                 DateTime      @db.Date
  amount               Decimal       @db.Decimal(14, 2)
  description          String
  status               RequestStatus @default(DRAFT)
  managerId            String?       @db.Uuid
  paymentMethod        String
  paymentDate          DateTime?     @db.Date
  paymentReference     String?
  files                StoredFile[]
  decisionComment      String?
  decidedBy            String?       @db.Uuid
  submittedAt          DateTime?     @db.Timestamptz(3)
  policySnapshot       Json?
  events               ClaimEvent[]
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  employee             Employee      @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)
  type                 ClaimType     @relation(fields: [companyId, typeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, employeeId, status])
  @@map("claims")
}

model ClaimEvent {
  id        String        @id @default(uuid()) @db.Uuid
  companyId String        @db.Uuid
  claimId   String        @db.Uuid
  actorId   String        @db.Uuid
  action    String
  status    RequestStatus
  comment   String?
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  claim     Claim         @relation(fields: [companyId, claimId], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, claimId, createdAt])
  @@map("claim_events")
}

model StoredFile {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  employeeId   String   @db.Uuid
  uploadedBy   String   @db.Uuid
  originalName String
  mimeType     String
  size         Int
  sha256       String
  category     String
  claimId      String?  @db.Uuid
  archived     Boolean  @default(false)
  scanStatus   String   @default("UNSCANNED")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  employee     Employee @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)
  claim        Claim?   @relation(fields: [companyId, claimId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, employeeId, category])
  @@map("stored_files")
}

enum StatutoryScheme {
  EPF
  SOCSO
  EIS
  LINDUNG_24_JAM
  PCB
  HRD
}

model StatutoryRuleset {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     String          @db.Uuid
  scheme        StatutoryScheme
  category      String
  version       String
  effectiveFrom DateTime        @db.Date
  effectiveTo   DateTime?       @db.Date
  sourceUrl     String
  sourceSha256  String
  parameters    Json
  active        Boolean         @default(false)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, id])
  @@unique([companyId, scheme, category, version])
  @@index([companyId, scheme, category, effectiveFrom])
  @@map("statutory_rulesets")
}

model EmployeePayrollProfile {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  employeeId      String   @db.Uuid
  epfCategory     String
  socsoCategory   String
  eisCategory     String
  lindungCategory String
  pcbCategory     String
  hrdCategory     String
  taxInputs       Json
  employee        Employee @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, employeeId])
  @@map("employee_payroll_profiles")
}

model EmployeePayrollProfileVersion {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @db.Uuid
  employeeId           String   @db.Uuid
  revision             Int
  effectiveFrom        DateTime @db.Date
  epfCategory          String
  socsoCategory        String
  eisCategory          String
  lindungCategory      String
  pcbCategory          String
  hrdCategory          String
  lindungParticipation String
  reason               String
  recordedBy           String   @db.Uuid
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  employee             Employee @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, employeeId, revision])
  @@index([companyId, employeeId, effectiveFrom, revision])
  @@map("employee_payroll_profile_versions")
}

model EmployeeTaxExpenses {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  employeeId        String   @db.Uuid
  year              Int
  effectiveMonth    Int
  revision          Int
  amounts           Json
  evidenceReference String
  reason            String
  recordedBy        String   @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  employee          Employee @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, employeeId, year, revision])
  @@index([companyId, employeeId, year, effectiveMonth, revision])
  @@map("employee_tax_expenses")
}

model EmployeeTaxFamily {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  employeeId        String   @db.Uuid
  year              Int
  effectiveMonth    Int
  revision          Int
  declaration       Json
  reliefs           Json
  evidenceReference String
  reason            String
  recordedBy        String   @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  employee          Employee @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, employeeId, year, revision])
  @@index([companyId, employeeId, year, effectiveMonth, revision])
  @@map("employee_tax_families")
}

model EmployeeTaxOpening {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  employeeId        String   @db.Uuid
  year              Int
  effectiveMonth    Int
  revision          Int
  taxableIncome     Decimal  @db.Decimal(14, 2)
  employeeEpf       Decimal  @db.Decimal(14, 2)
  mtd               Decimal  @db.Decimal(14, 2)
  zakat             Decimal  @db.Decimal(14, 2)
  evidenceReference String
  reason            String
  recordedBy        String   @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  employee          Employee @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, employeeId, year, revision])
  @@index([companyId, employeeId, year, effectiveMonth, revision])
  @@map("employee_tax_openings")
}

model PayrollSettings {
  id           String  @id @default(uuid()) @db.Uuid
  companyId    String  @unique @db.Uuid
  cutoffDay    Int     @default(25)
  payDay       Int     @default(28)
  currency     String  @default("MYR") @db.Char(3)
  makerChecker Boolean @default(true)
  company      Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("payroll_settings")
}

model PayrollComponentDefinition {
  pcbTreatment   String            @default("UNCLASSIFIED")
  id             String            @id @default(uuid()) @db.Uuid
  companyId      String            @db.Uuid
  code           String
  revision       Int
  name           String
  kind           String
  effectiveFrom  DateTime          @db.Date
  active         Boolean
  affectsGross   Boolean
  affectsNet     Boolean
  statutoryBases StatutoryScheme[]
  reason         String
  recordedBy     String            @db.Uuid
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code, revision])
  @@index([companyId, code, effectiveFrom, revision])
  @@map("payroll_component_definitions")
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  APPROVED
  PUBLISHED
  PAID
}

model PayrollRun {
  claims           Claim[]
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @db.Uuid
  year             Int
  month            Int
  status           PayrollStatus     @default(DRAFT)
  createdBy        String            @db.Uuid
  approvedBy       String?           @db.Uuid
  approvedAt       DateTime?         @db.Timestamptz(3)
  paidAt           DateTime?         @db.Timestamptz(3)
  paymentReference String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees        PayrollEmployee[]
  inputs           PayrollInput[]

  @@unique([companyId, id])
  @@unique([companyId, year, month])
  @@map("payroll_runs")
}

model PayrollInput {
  id             String     @id @default(uuid()) @db.Uuid
  companyId      String     @db.Uuid
  runId          String     @db.Uuid
  employeeId     String     @db.Uuid
  idempotencyKey String     @db.Uuid
  componentCode  String
  amount         Decimal    @db.Decimal(14, 2)
  reason         String
  createdBy      String     @db.Uuid
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  voidedAt       DateTime?  @db.Timestamptz(3)
  voidedBy       String?    @db.Uuid
  voidReason     String?
  run            PayrollRun @relation(fields: [companyId, runId], references: [companyId, id], onDelete: Restrict)
  employee       Employee   @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, runId, idempotencyKey])
  @@index([companyId, runId, employeeId])
  @@map("payroll_inputs")
}

model PayrollEmployee {
  id                    String     @id @default(uuid()) @db.Uuid
  companyId             String     @db.Uuid
  runId                 String     @db.Uuid
  employeeId            String     @db.Uuid
  gross                 Decimal    @db.Decimal(14, 2)
  deductions            Decimal    @db.Decimal(14, 2)
  net                   Decimal    @db.Decimal(14, 2)
  employerContributions Decimal    @db.Decimal(14, 2)
  snapshot              Json
  run                   PayrollRun @relation(fields: [companyId, runId], references: [companyId, id], onDelete: Restrict)
  employee              Employee   @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, runId, employeeId])
  @@map("payroll_employees")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  HR
  FINANCE
  EMPLOYEE
}

model User {
  id               String       @id @default(uuid()) @db.Uuid
  email            String       @unique
  fullName         String?
  passwordHash     String
  active           Boolean      @default(true)
  tokenVersion     Int          @default(0)
  failedLoginCount Int          @default(0)
  lockedUntil      DateTime?    @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  memberships      Membership[]

  @@map("users")
}

model Company {
  id                          String                       @id @default(uuid()) @db.Uuid
  name                        String
  timezone                    String                       @default("Asia/Kuala_Lumpur")
  currency                    String                       @default("MYR") @db.Char(3)
  active                      Boolean                      @default(true)
  memberships                 Membership[]
  employees                   Employee[]
  employeeWorkSchedules       EmployeeWorkSchedule[]
  files                       StoredFile[]
  registrationNo              String?
  email                       String?
  contactNo                   String?
  financialYearStartMonth     Int                          @default(1)
  financialStartingMonth      String                       @default("JANUARY")
  sstNo                       String?
  taxNo                       String?
  website                     String?
  logo                        String?
  businessAddressLine1        String?
  businessAddressLine2        String?
  businessCity                String?
  businessPostcode            String?
  businessState               String?
  businessCountry             String?                      @default("MALAYSIA")
  departments                 Department[]
  positions                   Position[]
  locations                   WorkLocation[]
  schedules                   WorkSchedule[]
  holidays                    PublicHoliday[]
  leavePolicies               LeavePolicy[]
  claimTypes                  ClaimType[]
  auditEvents                 AuditEvent[]
  statutoryRules              StatutoryRuleset[]
  payrollSettings             PayrollSettings?
  payslipSettings             PayslipSettings?
  payrollRuns                 PayrollRun[]
  payrollComponentDefinitions PayrollComponentDefinition[]
  overtimeRequests            OvertimeRequest[]
  commissionSettings          CommissionIncentiveSetting[]
  commissionRecords           CommissionPayrollRecord[]
  notificationSettings        NotificationSettings?
  regionalSettings            RegionalSettings?

  @@map("companies")
}

model Membership {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  companyId  String    @db.Uuid
  employeeId String?   @db.Uuid
  employee   Employee? @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)
  roles      Role[]
  active     Boolean   @default(true)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, userId])
  @@unique([companyId, employeeId])
  @@map("company_memberships")
}

model Employee {
  id                     String                          @id @default(uuid()) @db.Uuid
  companyId              String                          @db.Uuid
  employeeNo             String
  name                   String
  email                  String?
  joinedDate             DateTime                        @db.Date
  active                 Boolean                         @default(true)
  departmentId           String?                         @db.Uuid
  positionId             String?                         @db.Uuid
  department             Department?                     @relation(fields: [companyId, departmentId], references: [companyId, id], onDelete: Restrict)
  position               Position?                       @relation(fields: [companyId, positionId], references: [companyId, id], onDelete: Restrict)
  createdAt              DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                        @updatedAt @db.Timestamptz(3)
  company                Company                         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  salaries               SalaryHistory[]
  membership             Membership?
  managerId              String?                         @db.Uuid
  manager                Employee?                       @relation("Manager", fields: [companyId, managerId], references: [companyId, id], onDelete: Restrict)
  reports                Employee[]                      @relation("Manager")
  locationId             String?                         @db.Uuid
  scheduleId             String?                         @db.Uuid
  location               WorkLocation?                   @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)
  schedule               WorkSchedule?                   @relation(fields: [companyId, scheduleId], references: [companyId, id], onDelete: Restrict)
  employeeWorkSchedule   EmployeeWorkSchedule?
  attendance             AttendanceSession[]
  leaveRequests          LeaveRequest[]
  leaveLedger            LeaveLedger[]
  claims                 Claim[]
  files                  StoredFile[]
  payrollProfile         EmployeePayrollProfile?
  payrollProfileVersions EmployeePayrollProfileVersion[]
  payslips               PayrollEmployee[]
  payrollInputs          PayrollInput[]
  taxOpenings            EmployeeTaxOpening[]
  taxFamilyVersions      EmployeeTaxFamily[]
  taxExpenseVersions     EmployeeTaxExpenses[]
  headedDepartments      Department[]                    @relation("HeadOfDepartment")
  overtimeRequests       OvertimeRequest[]
  commissionRecords      CommissionPayrollRecord[]

  // Personal Information
  nricPassportNo String?
  dateOfBirth    DateTime? @db.Date
  gender         String?
  nationality    String?
  race           String?
  religion       String?
  maritalStatus  String?
  tin            String?
  contactNo      String?
  address        String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  postcode       String?
  state          String?
  country        String?

  // Employment Details
  employmentStatus String?
  employmentType   String?
  confirmationDate DateTime? @db.Date
  resignationDate  DateTime? @db.Date

  // Banking & Payroll
  salaryType    String?
  paymentMethod String?
  bank          String?
  bankAccount   String?

  // Statutory Identifiers & Rates
  epfEmployeeNo             String?
  epfEmployerNo             String?
  epfRate                   String?
  kwspNo                    String?
  socsoNo                   String?
  contributionCategory      String?
  eisStatus                 String?
  hrdRegisterNo             String?
  statutoryEntitlementCodes String[] @default([])

  // Overtime Settings
  includeOvertime          Boolean  @default(false)
  overtimeCalculationBasis String?
  overtimeHourlyRate       Decimal? @db.Decimal(14, 2)

  // Emergency Contact
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactNo           String?
  emergencyContactAddressLine1 String?
  emergencyContactAddressLine2 String?
  emergencyContactCity         String?
  emergencyContactPostcode     String?
  emergencyContactState        String?
  emergencyContactCountry      String?

  // Leave & Commission Assignments
  leavePolicyCodes             String[] @default([])
  leaveEntitlementOverrides    Json?
  leaveServiceEntitlementTiers Json?
  medicalLeaveEntitlement      Decimal? @db.Decimal(7, 2)
  medicalLeavePeriod           String?
  commissionSettingCodes       String[] @default([])

  @@unique([companyId, id])
  @@unique([companyId, employeeNo])
  @@map("employees")
}

model Department {
  id                 String            @id @default(uuid()) @db.Uuid
  companyId          String            @db.Uuid
  code               String
  name               String
  shortName          String?
  description        String?
  remark             String?
  parentDepartmentId String?           @db.Uuid
  headOfDepartmentId String?           @db.Uuid
  effectiveFrom      DateTime?         @db.Date
  effectiveTo        DateTime?         @db.Date
  status             String?
  active             Boolean           @default(true)
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parentDepartment   Department?       @relation("DepartmentHierarchy", fields: [companyId, parentDepartmentId], references: [companyId, id], onDelete: Restrict)
  subDepartments     Department[]      @relation("DepartmentHierarchy")
  headOfDepartment   Employee?         @relation("HeadOfDepartment", fields: [companyId, headOfDepartmentId], references: [companyId, id], onDelete: Restrict)
  employees          Employee[]
  positions          Position[]
  overtimeRequests   OvertimeRequest[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@map("departments")
}

model Position {
  id            String      @id @default(uuid()) @db.Uuid
  companyId     String      @db.Uuid
  departmentId  String?     @db.Uuid
  code          String
  title         String
  jobLevel      String?
  description   String?
  reportsTo     String?
  effectiveFrom DateTime?   @db.Date
  effectiveTo   DateTime?   @db.Date
  active        Boolean     @default(true)
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department    Department? @relation(fields: [companyId, departmentId], references: [companyId, id], onDelete: Restrict)
  employees     Employee[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@map("positions")
}

model SalaryHistory {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  employeeId    String    @db.Uuid
  amount        Decimal   @db.Decimal(14, 2)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  employee      Employee  @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, employeeId, effectiveFrom])
  @@map("salary_history")
}

model WorkLocation {
  id           String     @id @default(uuid()) @db.Uuid
  companyId    String     @db.Uuid
  code         String
  name         String
  type         String?
  remark       String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  postcode     String?
  state        String
  country      String?    @default("MALAYSIA")
  address      String?
  timezone     String     @default("Asia/Kuala_Lumpur")
  active       Boolean    @default(true)
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees    Employee[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@map("work_locations")
}

model WorkSchedule {
  id             String     @id @default(uuid()) @db.Uuid
  companyId      String     @db.Uuid
  code           String
  name           String
  workingDays    Int[]
  startMinute    Int
  endMinute      Int
  breakMinutes   Int        @default(0)
  graceMinutes   Int        @default(0)
  scheduleDays   Json?
  employmentType String?
  effectiveFrom  DateTime   @db.Date
  effectiveTo    DateTime?  @db.Date
  active         Boolean    @default(true)
  company        Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees      Employee[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@map("work_schedules")
}

model EmployeeWorkSchedule {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  employeeId    String    @db.Uuid
  scheduleDays  Json
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  active        Boolean   @default(true)
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee      Employee  @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@unique([companyId, employeeId])
  @@index([companyId, employeeId, active])
  @@map("employee_work_schedules")
}

model PublicHoliday {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  code        Int
  name        String
  description String?
  scope       String   @default("NATIONAL")
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  states      String[]
  active      Boolean  @default(true)
  regions     String[] @default([])
  status      String   @default("ACTIVE")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@index([companyId, startDate, endDate])
  @@map("public_holidays")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  actorId    String   @db.Uuid
  action     String
  resourceId String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@map("audit_events")
}

model AttendanceSession {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @db.Uuid
  employeeId         String    @db.Uuid
  date               DateTime  @db.Date
  clockIn            DateTime  @db.Timestamptz(3)
  clockOut           DateTime? @db.Timestamptz(3)
  durationMinutes    Int?
  hoursWorkedMinutes Int?
  overtimeMinutes    Int       @default(0)
  remark             String?
  clockInKey         String
  clockOutKey        String?
  employee           Employee  @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, employeeId, clockInKey])
  @@unique([companyId, employeeId, clockOutKey])
  @@index([companyId, employeeId, date])
  @@index([companyId, employeeId, clockIn])
  @@map("attendance_sessions")
}

enum RequestStatus {
  DRAFT
  PENDING_MANAGER
  PENDING_HR
  PENDING_FINANCE
  APPROVED
  REJECTED
  CANCELLED
  PAID
}

enum LeaveApproval {
  MANAGER
  MANAGER_HR
  HR_ONLY
  NO_APPROVAL
}

model LeavePolicy {
  id                            String         @id @default(uuid()) @db.Uuid
  companyId                     String         @db.Uuid
  code                          String
  name                          String
  description                   String?
  paid                          Boolean        @default(true)
  active                        Boolean        @default(true)
  entitlementUnit               String         @default("DAILY")
  entitlementCalculationMethod  String         @default("FIXED")
  defaultEntitlement            Decimal?       @db.Decimal(7, 2)
  serviceEntitlementTiers       Json?
  entitlementGrantMethod        String         @default("ANNUAL")
  eligibility                   String         @default("ALL_EMPLOYEES")
  leaveYear                     String         @default("CALENDAR")
  carryForwardPolicy            String         @default("NONE")
  maximumCarryForward           Decimal?       @db.Decimal(7, 2)
  requireSupportingDocuments    Boolean        @default(false)
  allowEmployeeSpecificSettings Boolean        @default(true)
  allowHalfDay                  Boolean        @default(false)
  noticeDays                    Int            @default(0)
  approval                      LeaveApproval  @default(HR_ONLY)
  effectiveFrom                 DateTime       @db.Date
  effectiveTo                   DateTime?      @db.Date
  company                       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requests                      LeaveRequest[]
  ledger                        LeaveLedger[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@map("leave_policies")
}

model LeaveRequest {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @db.Uuid
  employeeId      String        @db.Uuid
  policyId        String        @db.Uuid
  reference       String?
  requestDate     DateTime      @db.Date
  startDate       DateTime      @db.Date
  endDate         DateTime      @db.Date
  halfDay         Boolean       @default(false)
  days            Decimal       @db.Decimal(7, 2)
  daySnapshot     Json?
  reason          String
  status          RequestStatus @default(DRAFT)
  managerId       String?       @db.Uuid
  approval        LeaveApproval
  paid            Boolean
  decisionComment String?
  decidedBy       String?       @db.Uuid
  decidedAt       DateTime?     @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  employee        Employee      @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)
  policy          LeavePolicy   @relation(fields: [companyId, policyId], references: [companyId, id], onDelete: Restrict)
  ledger          LeaveLedger[]
  events          LeaveEvent[]
  files           StoredFile[]

  @@unique([companyId, id])
  @@index([companyId, employeeId, startDate, endDate])
  @@map("leave_requests")
}

model LeaveEvent {
  id        String        @id @default(uuid()) @db.Uuid
  companyId String        @db.Uuid
  requestId String        @db.Uuid
  actorId   String        @db.Uuid
  action    String
  status    RequestStatus
  comment   String?
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  request   LeaveRequest  @relation(fields: [companyId, requestId], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, requestId, createdAt])
  @@map("leave_events")
}

model LeaveLedger {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String        @db.Uuid
  employeeId     String        @db.Uuid
  policyId       String        @db.Uuid
  requestId      String?       @db.Uuid
  year           Int
  days           Decimal       @db.Decimal(7, 2)
  kind           String
  reason         String
  idempotencyKey String
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  employee       Employee      @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)
  policy         LeavePolicy   @relation(fields: [companyId, policyId], references: [companyId, id], onDelete: Restrict)
  request        LeaveRequest? @relation(fields: [companyId, requestId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, idempotencyKey])
  @@index([companyId, employeeId, policyId, year])
  @@map("leave_ledger")
}

model ClaimType {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  code            String
  name            String
  active          Boolean   @default(true)
  description     String?
  receiptRequired Boolean   @default(false)
  maxAmount       Decimal?  @db.Decimal(14, 2)
  effectiveFrom   DateTime? @db.Date
  effectiveTo     DateTime? @db.Date
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  claims          Claim[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@map("claim_types")
}

model Claim {
  payrollRunId         String?       @db.Uuid
  payrollComponentCode String?
  payrollRun           PayrollRun?   @relation(fields: [companyId, payrollRunId], references: [companyId, id], onDelete: Restrict)
  id                   String        @id @default(uuid()) @db.Uuid
  companyId            String        @db.Uuid
  employeeId           String        @db.Uuid
  typeId               String        @db.Uuid
  date                 DateTime      @db.Date
  amount               Decimal       @db.Decimal(14, 2)
  description          String
  status               RequestStatus @default(DRAFT)
  managerId            String?       @db.Uuid
  paymentMethod        String
  paymentDate          DateTime?     @db.Date
  paymentReference     String?
  files                StoredFile[]
  decisionComment      String?
  decidedBy            String?       @db.Uuid
  submittedAt          DateTime?     @db.Timestamptz(3)
  policySnapshot       Json?
  events               ClaimEvent[]
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  employee             Employee      @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)
  type                 ClaimType     @relation(fields: [companyId, typeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, employeeId, status])
  @@map("claims")
}

model ClaimEvent {
  id        String        @id @default(uuid()) @db.Uuid
  companyId String        @db.Uuid
  claimId   String        @db.Uuid
  actorId   String        @db.Uuid
  action    String
  status    RequestStatus
  comment   String?
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  claim     Claim         @relation(fields: [companyId, claimId], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, claimId, createdAt])
  @@map("claim_events")
}

model StoredFile {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @db.Uuid
  employeeId        String?          @db.Uuid
  uploadedBy        String           @db.Uuid
  originalName      String
  mimeType          String
  size              Int
  sha256            String
  category          String
  claimId           String?          @db.Uuid
  leaveRequestId    String?          @db.Uuid
  overtimeRequestId String?          @db.Uuid
  archived          Boolean          @default(false)
  scanStatus        String           @default("UNSCANNED")
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee          Employee?        @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)
  claim             Claim?           @relation(fields: [companyId, claimId], references: [companyId, id], onDelete: Restrict)
  leaveRequest      LeaveRequest?    @relation(fields: [companyId, leaveRequestId], references: [companyId, id], onDelete: Restrict)
  overtimeRequest   OvertimeRequest? @relation(fields: [companyId, overtimeRequestId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, employeeId, category])
  @@map("stored_files")
}

enum StatutoryScheme {
  EPF
  SOCSO
  EIS
  LINDUNG_24_JAM
  PCB
  HRD
}

model StatutoryRuleset {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     String          @db.Uuid
  scheme        StatutoryScheme
  category      String
  version       String
  effectiveFrom DateTime        @db.Date
  effectiveTo   DateTime?       @db.Date
  sourceUrl     String
  sourceSha256  String
  parameters    Json
  active        Boolean         @default(false)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, id])
  @@unique([companyId, scheme, category, version])
  @@index([companyId, scheme, category, effectiveFrom])
  @@map("statutory_rulesets")
}

model EmployeePayrollProfile {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  employeeId      String   @db.Uuid
  epfCategory     String
  socsoCategory   String
  eisCategory     String
  lindungCategory String
  pcbCategory     String
  hrdCategory     String
  taxInputs       Json
  employee        Employee @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, employeeId])
  @@map("employee_payroll_profiles")
}

model EmployeePayrollProfileVersion {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @db.Uuid
  employeeId           String   @db.Uuid
  revision             Int
  effectiveFrom        DateTime @db.Date
  epfCategory          String
  socsoCategory        String
  eisCategory          String
  lindungCategory      String
  pcbCategory          String
  hrdCategory          String
  lindungParticipation String
  reason               String
  recordedBy           String   @db.Uuid
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  employee             Employee @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, employeeId, revision])
  @@index([companyId, employeeId, effectiveFrom, revision])
  @@map("employee_payroll_profile_versions")
}

model EmployeeTaxExpenses {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  employeeId        String   @db.Uuid
  year              Int
  effectiveMonth    Int
  revision          Int
  amounts           Json
  evidenceReference String
  reason            String
  recordedBy        String   @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  employee          Employee @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, employeeId, year, revision])
  @@index([companyId, employeeId, year, effectiveMonth, revision])
  @@map("employee_tax_expenses")
}

model EmployeeTaxFamily {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  employeeId        String   @db.Uuid
  year              Int
  effectiveMonth    Int
  revision          Int
  declaration       Json
  reliefs           Json
  evidenceReference String
  reason            String
  recordedBy        String   @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  employee          Employee @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, employeeId, year, revision])
  @@index([companyId, employeeId, year, effectiveMonth, revision])
  @@map("employee_tax_families")
}

model EmployeeTaxOpening {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  employeeId        String   @db.Uuid
  year              Int
  effectiveMonth    Int
  revision          Int
  taxableIncome     Decimal  @db.Decimal(14, 2)
  employeeEpf       Decimal  @db.Decimal(14, 2)
  mtd               Decimal  @db.Decimal(14, 2)
  zakat             Decimal  @db.Decimal(14, 2)
  evidenceReference String
  reason            String
  recordedBy        String   @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  employee          Employee @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, employeeId, year, revision])
  @@index([companyId, employeeId, year, effectiveMonth, revision])
  @@map("employee_tax_openings")
}

model PayrollSettings {
  id                              String   @id @default(uuid()) @db.Uuid
  companyId                       String   @unique @db.Uuid
  cutoffDay                       Int      @default(25)
  payDay                          Int      @default(28)
  payrollCutoffDay                String   @default("25")
  currency                        String   @default("MYR") @db.Char(3)
  makerChecker                    Boolean  @default(true)
  payrollFrequency                String   @default("MONTHLY")
  scheduledPayDate                String   @default("28")
  salaryProrationMethod           String   @default("CALENDAR_DAYS")
  calculationPrecision            Int      @default(2)
  includeBasicSalary              Boolean  @default(true)
  includeOvertime                 Boolean  @default(true)
  includeClaimsAndAllowance       Boolean  @default(true)
  includeBonus                    Boolean  @default(true)
  includeCommissionAndIncentives  Boolean  @default(true)
  standardWorkingHoursPerDay      Decimal? @default(8) @db.Decimal(5, 2)
  normalWorkingDayMultiplier      Decimal? @default(1.5) @db.Decimal(5, 2)
  normalWorkingDayEarningCode     String   @default("OT")
  configureRestDayRates           Boolean  @default(true)
  restDayOvertimeMultiplier       Decimal? @default(2.0) @db.Decimal(5, 2)
  restDayEarningCode              String   @default("OT-REST")
  configurePublicHolidayRates     Boolean  @default(true)
  publicHolidayOvertimeMultiplier Decimal? @default(3.0) @db.Decimal(5, 2)
  publicHolidayEarningCode        String   @default("OT-PH")
  deductionProrationMethod        String   @default("FOLLOW_SALARY_PRORATION")
  includeEpf                      Boolean  @default(true)
  includeSocso                    Boolean  @default(true)
  includeEis                      Boolean  @default(true)
  includePcb                      Boolean  @default(true)
  includeHrdCorpLevy              Boolean  @default(false)
  paymentMethod                   String   @default("BANK_TRANSFER")
  automaticallyCalculatePayroll   Boolean  @default(true)
  blockApprovalOnValidationErrors Boolean  @default(true)
  lockAfterFinalApproval          Boolean  @default(true)
  notifyApprovers                 Boolean  @default(true)
  approvalWorkflow                String   @default("ONE_APPROVER")
  company                         Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("payroll_settings")
}

model PayrollComponentDefinition {
  pcbTreatment   String            @default("UNCLASSIFIED")
  id             String            @id @default(uuid()) @db.Uuid
  companyId      String            @db.Uuid
  code           String
  revision       Int
  name           String
  kind           String
  effectiveFrom  DateTime          @db.Date
  active         Boolean
  affectsGross   Boolean
  affectsNet     Boolean
  statutoryBases StatutoryScheme[]
  reason         String
  recordedBy     String            @db.Uuid
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code, revision])
  @@index([companyId, code, effectiveFrom, revision])
  @@map("payroll_component_definitions")
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  APPROVED
  PUBLISHED
  PAID
}

model PayrollRun {
  commissionAllocationEvents CommissionAllocationEvent[]
  claims                     Claim[]
  overtimeRequests           OvertimeRequest[]
  commissionRecords          CommissionPayrollRecord[]
  id                         String                      @id @default(uuid()) @db.Uuid
  companyId                  String                      @db.Uuid
  year                       Int
  month                      Int
  status                     PayrollStatus               @default(DRAFT)
  createdBy                  String                      @db.Uuid
  approvedBy                 String?                     @db.Uuid
  approvedAt                 DateTime?                   @db.Timestamptz(3)
  paidAt                     DateTime?                   @db.Timestamptz(3)
  paymentReference           String?
  createdAt                  DateTime                    @default(now()) @db.Timestamptz(3)
  company                    Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees                  PayrollEmployee[]
  inputs                     PayrollInput[]

  @@unique([companyId, id])
  @@unique([companyId, year, month])
  @@map("payroll_runs")
}

model PayrollInput {
  id             String     @id @default(uuid()) @db.Uuid
  companyId      String     @db.Uuid
  runId          String     @db.Uuid
  employeeId     String     @db.Uuid
  idempotencyKey String     @db.Uuid
  componentCode  String
  amount         Decimal    @db.Decimal(14, 2)
  reason         String
  createdBy      String     @db.Uuid
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  voidedAt       DateTime?  @db.Timestamptz(3)
  voidedBy       String?    @db.Uuid
  voidReason     String?
  run            PayrollRun @relation(fields: [companyId, runId], references: [companyId, id], onDelete: Restrict)
  employee       Employee   @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, runId, idempotencyKey])
  @@index([companyId, runId, employeeId])
  @@map("payroll_inputs")
}

model PayrollEmployee {
  id                    String     @id @default(uuid()) @db.Uuid
  companyId             String     @db.Uuid
  runId                 String     @db.Uuid
  employeeId            String     @db.Uuid
  gross                 Decimal    @db.Decimal(14, 2)
  deductions            Decimal    @db.Decimal(14, 2)
  net                   Decimal    @db.Decimal(14, 2)
  employerContributions Decimal    @db.Decimal(14, 2)
  snapshot              Json
  run                   PayrollRun @relation(fields: [companyId, runId], references: [companyId, id], onDelete: Restrict)
  employee              Employee   @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, runId, employeeId])
  @@map("payroll_employees")
}

model PayslipSettings {

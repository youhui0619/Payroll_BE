model OvertimeRequest {
  id                   String        @id @default(uuid()) @db.Uuid
  companyId            String        @db.Uuid
  employeeId           String        @db.Uuid
  departmentId         String?       @db.Uuid
  requestDate          DateTime      @db.Date
  overtimeDate         DateTime      @db.Date
  overtimeType         String        @default("NORMAL_WORKING_DAY")
  startTime            String
  endTime              String
  totalMinutes         Int
  breakDurationMinutes Int           @default(0)
  netMinutes           Int
  hourlyRateMultiplier Decimal       @default(1.5) @db.Decimal(5, 2)
  earningCode          String        @default("OT")
  description          String
  status               RequestStatus @default(DRAFT)
  submittedAt          DateTime?     @db.Timestamptz(3)
  decisionComment      String?
  decidedBy            String?       @db.Uuid
  decidedAt            DateTime?     @db.Timestamptz(3)
  payrollRunId         String?       @db.Uuid
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  company              Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee             Employee      @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)
  department           Department?   @relation(fields: [companyId, departmentId], references: [companyId, id], onDelete: Restrict)
  payrollRun           PayrollRun?   @relation(fields: [companyId, payrollRunId], references: [companyId, id], onDelete: Restrict)
  files                StoredFile[]

  @@unique([companyId, id])
  @@index([companyId, employeeId, overtimeDate])
  @@index([companyId, status])
  @@map("overtime_requests")
}

model CommissionIncentiveSetting {
  id                    String                    @id @default(uuid()) @db.Uuid
  companyId             String                    @db.Uuid
  code                  String
  name                  String
  commissionType        String
  calculationMethod     String
  rate                  Decimal?                  @db.Decimal(7, 4)
  amount                Decimal?                  @db.Decimal(14, 2)
  calculationFrequency  String                    @default("MONTHLY")
  payoutTiming          String                    @default("CURRENT_PAYROLL")
  description           String?
  eligibleEmployees     String                    @default("ALL_EMPLOYEES")
  eligibleDepartmentIds String[]                  @default([])
  eligiblePositionIds   String[]                  @default([])
  eligibleEmployeeIds   String[]                  @default([])
  payrollEarningCode    String
  requiresApproval      Boolean                   @default(true)
  active                Boolean                   @default(true)
  createdAt             DateTime                  @default(now()) @db.Timestamptz(3)
  company               Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  records               CommissionPayrollRecord[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@map("commission_incentive_settings")
}

model CommissionPayrollRecord {
  allocationEvents     CommissionAllocationEvent[]
  id                   String                      @id @default(uuid()) @db.Uuid
  companyId            String                      @db.Uuid
  employeeId           String                      @db.Uuid
  settingId            String?                     @db.Uuid
  planCode             String
  planName             String?
  payrollEarningCode   String
  calculationMethod    String?
  calculationFrequency String?
  payoutTiming         String?
  calculationBasis     Decimal?                    @db.Decimal(14, 2)
  rate                 Decimal?                    @db.Decimal(7, 4)
  amount               Decimal                     @db.Decimal(14, 2)
  referenceId          String?
  notes                String?
  createdDate          DateTime                    @default(now()) @db.Date
  status               String                      @default("PENDING_APPROVAL")
  approvedBy           String?                     @db.Uuid
  approvedAt           DateTime?                   @db.Timestamptz(3)
  approvalComment      String?
  payrollRunId         String?                     @db.Uuid
  createdAt            DateTime                    @default(now()) @db.Timestamptz(3)
  company              Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee             Employee                    @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)
  setting              CommissionIncentiveSetting? @relation(fields: [companyId, settingId], references: [companyId, id], onDelete: Restrict)
  payrollRun           PayrollRun?                 @relation(fields: [companyId, payrollRunId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, employeeId, status])
  @@index([companyId, payrollRunId])
  @@map("commission_payroll_records")
}

model CommissionAllocationEvent {
  id        String                  @id @default(uuid()) @db.Uuid
  companyId String                  @db.Uuid
  recordId  String                  @db.Uuid
  runId     String                  @db.Uuid
  actorId   String                  @db.Uuid
  action    String
  reason    String
  createdAt DateTime                @default(now()) @db.Timestamptz(3)
  record    CommissionPayrollRecord @relation(fields: [companyId, recordId], references: [companyId, id], onDelete: Restrict)
  run       PayrollRun              @relation(fields: [companyId, runId], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, recordId, createdAt])
  @@map("commission_allocation_events")
}


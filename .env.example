DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL_SECONDS=3600
SEED_COMPANY_NAME=Your Company
SEED_OWNER_EMAIL=owner@example.test
SEED_OWNER_PASSWORD=
PORT=3000
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:4200
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=storage
ALLOW_UNSCANNED_UPLOADS=false
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
# For S3: set STORAGE_PROVIDER=s3, S3_BUCKET, AWS_REGION and credentials via the standard AWS provider chain.
